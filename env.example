# AI SEC Filing Analyzer - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Required: Google AI Studio API Key (get free key at https://aistudio.google.com/)
GOOGLE_API_KEY=your-google-ai-key-here

# Environment Configuration
ENVIRONMENT=development  # development or production
DEBUG=true              # true for development, false for production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vector Database Configuration
VECTOR_DB_PATH=./chroma_db
COLLECTION_NAME=sec_filings

# Document Processing Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS=100

# API Configuration
MAX_RESPONSE_LENGTH=4000
REQUEST_TIMEOUT=60

# AI Model Configuration
GEMINI_MODEL=gemini-2.5-flash
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Application Settings
APP_NAME=AI SEC Filing Analyzer
VERSION=1.0.0

# Production Settings (uncomment and configure for production)
# ENVIRONMENT=production
# DEBUG=false
# ALLOWED_ORIGINS=https://your-domain.com
# GOOGLE_API_KEY=your-production-api-key 